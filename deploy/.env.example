# Copy to .env and fill in. Generate secrets with: openssl rand -base64 24
DOMAIN=saguki.example.com
DB_PASSWORD=change-me
# The password the apps use to connect a device (12+ chars).
SAGUKI_PASSWORD=change-me-too

# Profile pictures go to Cloudflare R2 (R2 → Manage API tokens → Object Read & Write, this bucket only).
# Objects land at $R2_PREFIX<sha256>.png and are linked as $R2_PUBLIC_URL/$R2_PREFIX<sha256>.png
R2_ACCOUNT_ID=
# Either a Cloudflare API token with R2 write access (cfut_…)…
R2_TOKEN=
# …or the token's S3 keys.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=social-credit-gacha
R2_PREFIX=pfps/
R2_PUBLIC_URL=https://cdn.off-by-one.digital
